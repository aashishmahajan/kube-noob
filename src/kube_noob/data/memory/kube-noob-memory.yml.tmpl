# Validates this memory repository on every pull request and on main: schema, duplicates, credentials, review dates
# and the fix verifier (every patch is validated, audited and red-teamed; privileged SCC, cluster-admin, hostPath and
# wildcard RBAC grants fail unless the entry records riskAccepted). Generated by kube-noob $version.
name: kube-noob memory
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
        with:
          python-version: "3.13"
      - run: python -m pip install "kube-noob==$version"
      - run: kube-noob memory validate .
