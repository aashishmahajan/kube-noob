{
  "mcpServers": {
    "kube-noob": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--exact",
        "--isolated",
        "--quiet",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-I",
        "-B",
        "${CLAUDE_PLUGIN_ROOT}/server/kube_noob_plugin.py"
      ],
      "env": {
        "KUBE_NOOB_WEB_ENABLED": "false",
        "KUBE_NOOB_CLUSTER_ENABLED": "false",
        "KUBE_NOOB_LLM_PROVIDER": "none",
        "KUBE_NOOB_MUST_GATHER_DIR": "${user_config.must_gather_dir}"
      }
    }
  }
}
