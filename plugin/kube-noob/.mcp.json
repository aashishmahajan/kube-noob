{
  "mcpServers": {
    "kube-noob": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--exact",
        "--quiet",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/server/kube_noob_plugin.py"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "KUBE_NOOB_WEB_ENABLED": "false",
        "KUBE_NOOB_CLUSTER_ENABLED": "false",
        "KUBE_NOOB_LLM_PROVIDER": "none"
      }
    }
  }
}
