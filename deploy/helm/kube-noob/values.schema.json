{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "config",
    "auth",
    "service"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "config": {
      "type": "object",
      "properties": {
        "webEnabled": {
          "type": "boolean"
        },
        "clusterEnabled": {
          "type": "boolean"
        },
        "allowedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultPlatform": {
          "enum": [
            "kubernetes",
            "openshift",
            "rosa-classic",
            "rosa-hcp"
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "allowUnauthenticated": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "cluster",
            "namespace"
          ]
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        }
      }
    },
    "egressFirewall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "defaultDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([A-Za-z0-9-]+\\.)+[A-Za-z]{2,}$"
          }
        },
        "extraDnsNames": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?([A-Za-z0-9-]+\\.)+[A-Za-z]{2,}$"
          }
        },
        "denyCIDRs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 3600
        }
      }
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sync": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "projects": {
              "type": "string",
              "pattern": "^(default|all|[A-Za-z][A-Za-z0-9_]{1,29}(\\s*,\\s*[A-Za-z][A-Za-z0-9_]{1,29})*)$"
            },
            "intervalHours": {
              "type": "integer",
              "minimum": 6,
              "maximum": 168
            },
            "maxRequests": {
              "type": "integer",
              "minimum": 10,
              "maximum": 20000
            }
          }
        },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "none",
                "image",
                "pvc"
              ]
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^([a-z0-9][a-z0-9._/:-]{0,254})?$"
                },
                "tag": {
                  "type": "string",
                  "pattern": "^([A-Za-z0-9_][A-Za-z0-9._-]{0,127})?$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:[a-f0-9]{64})?$"
                }
              }
            },
            "path": {
              "type": "string",
              "pattern": "^/([A-Za-z0-9_-][A-Za-z0-9._-]{0,99}/){0,8}[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}\\.tgz(\\.enc)?$"
            },
            "pvc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claimName": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$"
                },
                "subPath": {
                  "type": "string",
                  "pattern": "^([A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,5})?$"
                }
              }
            },
            "sizeLimit": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,4}(Mi|Gi)$"
            },
            "keySecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[-._a-zA-Z0-9]{1,253}$"
                }
              }
            }
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "apiGroups",
              "resources"
            ],
            "properties": {
              "apiGroups": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9.-]*$"
                }
              },
              "resources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*$",
                  "not": {
                    "enum": [
                      "secrets",
                      "*"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "itsm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writeEnabled": {
          "type": "boolean"
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "db": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/:-]{0,254}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          }
        },
        "path": {
          "type": "string",
          "pattern": "^/([A-Za-z0-9_-][A-Za-z0-9._-]{0,99}/){0,8}[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}\\.tgz$"
        },
        "sizeLimit": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,4}(Mi|Gi)$"
        }
      }
    },
    "mustGather": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pvc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claimName": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$"
            },
            "subPath": {
              "type": "string",
              "pattern": "^([A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,5})?$"
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "none",
            "configMap",
            "pvc",
            "git"
          ]
        },
        "configMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$"
            }
          }
        },
        "pvc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claimName": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$"
            },
            "subPath": {
              "type": "string",
              "pattern": "^([A-Za-z0-9_-][A-Za-z0-9._-]{0,99}(/[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}){0,5})?$"
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(https://[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]{0,500})?|ssh://([A-Za-z0-9._-]{1,64}@)?[A-Za-z0-9.-]{1,253}(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]{0,500})?)?$"
            },
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^([a-z0-9][a-z0-9._/:-]{0,254})?$"
                },
                "tag": {
                  "type": "string",
                  "pattern": "^([A-Za-z0-9_][A-Za-z0-9._-]{0,127})?$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^(sha256:[a-f0-9]{64})?$"
                }
              }
            },
            "sshSecret": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$"
            },
            "egressCIDRs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
              }
            },
            "port": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "keep": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          }
        }
      }
    },
    "rhacs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$"
        },
        "tokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 253
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            }
          }
        },
        "caConfigMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 253
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            }
          }
        },
        "centralNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "egressCIDRs": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "maxPolicies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "enforce": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^KN-[A-Z]{1,3}[0-9]{3}$"
          }
        },
        "excludedNamespaces": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          }
        },
        "exceptions": {
          "type": "string",
          "maxLength": 200000
        },
        "lookups": {
          "type": "boolean"
        },
        "maxWarnings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "platformVersion": {
          "type": "string",
          "pattern": "^(\\d+\\.\\d+(\\.\\d+)?)?$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "certificates": {
          "type": "string",
          "enum": [
            "openshift-service-ca",
            "cert-manager",
            "secret"
          ]
        },
        "certManager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuerRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Issuer",
                    "ClusterIssuer"
                  ]
                }
              }
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": {
              "type": "string",
              "maxLength": 253
            },
            "caBundle": {
              "type": "string",
              "maxLength": 100000,
              "pattern": "^[A-Za-z0-9+/=]*$"
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object"
              }
            }
          }
        },
        "priorityClassName": {
          "type": "string",
          "maxLength": 253
        },
        "resources": {
          "type": "object"
        }
      }
    }
  }
}
