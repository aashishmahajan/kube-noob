{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "config",
    "auth",
    "service"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "config": {
      "type": "object",
      "properties": {
        "webEnabled": {
          "type": "boolean"
        },
        "clusterEnabled": {
          "type": "boolean"
        },
        "allowedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultPlatform": {
          "enum": [
            "kubernetes",
            "openshift",
            "rosa-classic",
            "rosa-hcp"
          ]
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "allowUnauthenticated": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "scope": {
          "enum": [
            "cluster",
            "namespace"
          ]
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        }
      }
    },
    "egressFirewall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "defaultDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([A-Za-z0-9-]+\\.)+[A-Za-z]{2,}$"
          }
        },
        "extraDnsNames": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?([A-Za-z0-9-]+\\.)+[A-Za-z]{2,}$"
          }
        },
        "denyCIDRs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 3600
        }
      }
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sync": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "projects": {
              "type": "string",
              "pattern": "^(default|all|[A-Za-z][A-Za-z0-9_]{1,29}(\\s*,\\s*[A-Za-z][A-Za-z0-9_]{1,29})*)$"
            },
            "intervalHours": {
              "type": "integer",
              "minimum": 6,
              "maximum": 168
            },
            "maxRequests": {
              "type": "integer",
              "minimum": 10,
              "maximum": 20000
            }
          }
        }
      }
    }
  }
}
