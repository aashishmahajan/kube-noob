{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "config", "auth", "service"],
  "properties": {
    "image": {"type": "object", "required": ["repository"], "properties": {
      "repository": {"type": "string", "minLength": 1}, "tag": {"type": "string"},
      "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
      "pullPolicy": {"enum": ["IfNotPresent", "Always", "Never"]}}},
    "replicaCount": {"type": "integer", "minimum": 1},
    "config": {"type": "object", "properties": {
      "webEnabled": {"type": "boolean"}, "clusterEnabled": {"type": "boolean"},
      "allowedDomains": {"type": "array", "items": {"type": "string"}},
      "defaultPlatform": {"enum": ["kubernetes", "openshift", "rosa-classic", "rosa-hcp"]}}},
    "auth": {"type": "object", "properties": {"existingSecret": {"type": "string"},
      "allowUnauthenticated": {"type": "boolean"}}},
    "rbac": {"type": "object", "properties": {"scope": {"enum": ["cluster", "namespace"]}}},
    "networkPolicy": {"type": "object"},
    "service": {"type": "object", "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}}
  }
}
