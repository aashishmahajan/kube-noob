# Rendered by the release workflow (charmbracelet/vhs) and attached to the GitHub release as tour.gif.
# Local preview: vhs demos/tour.tape
Output demos/out/tour.gif
Require kube-noob
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 900
Set Padding 18
Set TypingSpeed 40ms
Type "kube-noob demo --list"
Sleep 400ms
Enter
Sleep 4s
