# Rendered by the release workflow (charmbracelet/vhs) and attached to the GitHub release as must-gather.gif.
# Local preview: vhs demos/must-gather.tape
Output demos/out/must-gather.gif
Require kube-noob
Set Shell "bash"
Set FontSize 15
Set Width 1300
Set Height 900
Set Padding 18
Set TypingSpeed 40ms
Type "kube-noob demo must-gather"
Sleep 400ms
Enter
Sleep 7s
